{
  "name": "libbitsub",
  "version": "1.12.0",
  "author": "altqx",
  "license": "MIT",
  "description": "High-performance WASM renderer for graphical subtitles (PGS, VobSub, and DVB)",
  "repository": {
    "type": "git",
    "url": "https://github.com/altqx/libbitsub"
  },
  "keywords": [
    "libbitsub",
    "pgs",
    "vobsub",
    "dvb",
    "subtitle",
    "wasm",
    "rust",
    "rendering",
    "video",
    "player",
    "videojs",
    "shaka",
    "hls.js",
    "react"
  ],
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./pkg": {
      "types": "./pkg/libbitsub.d.ts",
      "import": "./pkg/libbitsub.js",
      "default": "./pkg/libbitsub.js"
    },
    "./videojs": {
      "types": "./dist/integrations/videojs.d.ts",
      "import": "./dist/integrations/videojs.js",
      "default": "./dist/integrations/videojs.js"
    },
    "./shaka": {
      "types": "./dist/integrations/shaka.d.ts",
      "import": "./dist/integrations/shaka.js",
      "default": "./dist/integrations/shaka.js"
    },
    "./hlsjs": {
      "types": "./dist/integrations/hlsjs.d.ts",
      "import": "./dist/integrations/hlsjs.js",
      "default": "./dist/integrations/hlsjs.js"
    },
    "./react": {
      "types": "./dist/integrations/react.d.ts",
      "import": "./dist/integrations/react.js",
      "default": "./dist/integrations/react.js"
    },
    "./integrations": {
      "types": "./dist/integrations/index.d.ts",
      "import": "./dist/integrations/index.js",
      "default": "./dist/integrations/index.js"
    }
  },
  "files": [
    "dist",
    "pkg",
    "src/wrapper.ts",
    "src/integrations",
    "examples"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target web --out-dir pkg",
    "build:wasm:release": "wasm-pack build --release --target web --out-dir pkg",
    "build:wasm:bundler": "wasm-pack build --target bundler --out-dir pkg-bundler",
    "build:ts": "tsc",
    "build": "bun run build:wasm:release && bun run build:ts",
    "demo:build": "bun demo/build.ts",
    "demo:dev": "bun run demo:build && wrangler dev --config demo/wrangler.jsonc",
    "demo:deploy": "bun run demo:build && wrangler deploy --config demo/wrangler.jsonc",
    "clean": "rm -rf pkg pkg-bundler dist target",
    "test": "cargo test --workspace",
    "test:ts": "bun test src/ts",
    "test:visual": "bun tests/visual/run.mjs",
    "test:all": "bun run test && bun run test:ts && bun run test:visual",
    "test:wasm": "wasm-pack test --headless --chrome",
    "format": "cargo fmt && prettier . --write"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "libbitsub-registry": "npm:libbitsub@1.12.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "hls.js": ">=1.0.0",
    "react": ">=18.0.0",
    "shaka-player": ">=4.0.0",
    "video.js": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "hls.js": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "shaka-player": {
      "optional": true
    },
    "video.js": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@webgpu/types": "^0.1.71"
  }
}
